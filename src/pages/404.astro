---
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { rotas } from '../config/site';
---

<BaseLayout titulo="Página não encontrada">
  <section class="container-site py-24 text-center">
    <p class="text-sm font-semibold tracking-wide text-laranja-texto uppercase">Erro 404</p>
    <h1 class="mt-2 text-4xl font-black text-roxo">Página não encontrada</h1>
    <p class="mt-4 text-lg">O endereço acessado não existe ou foi movido.</p>
    <Button href={rotas.home} class="mt-8">Voltar para a página inicial</Button>
  </section>
</BaseLayout>
