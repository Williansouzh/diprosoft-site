# Integrações opcionais (deixe vazio para desativar).
# No GitHub Pages, cadastre como Variables em Settings → Secrets and variables → Actions.

# Google Analytics 4 — carrega só depois do consentimento de cookies.
PUBLIC_GA_ID=

# reCAPTCHA v3 — chave do site (a chave secreta fica no servidor que receber os formulários).
PUBLIC_RECAPTCHA_SITE_KEY=

# Build para domínio próprio: SITE_URL=https://www.diprosoft.com.br e BASE_PATH=/
SITE_URL=
BASE_PATH=
