---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  titulo: string;
  imagem: ImageMetadata;
  posicao?: string;
}

const { titulo, imagem, posicao = 'center' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-noite text-white">
  <Image
    src={imagem}
    alt=""
    widths={[768, 1280, 1920, imagem.width]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover"
    style={{ objectPosition: posicao }}
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-[#281535] from-10% via-[#281535]/75 via-40% to-[#281535]/0 to-75% max-md:bg-[#281535]/70"
    aria-hidden="true"
  >
  </div>
  <div class="container-site flex min-h-[32rem] flex-col justify-center py-14 md:min-h-[30rem] xl:min-h-[36.9rem]">
    <div class="max-w-2xl">
      <!-- Quebras de linha (\n) seguem o design a partir do tablet. -->
      <h1 class="text-4xl leading-tight font-bold md:text-5xl md:whitespace-pre-line xl:text-[3.6rem]">{titulo}</h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed md:text-xl">
        Soluções completas em tecnologia, gestão e automação comercial para empresas de pequeno, médio e grande
        porte.
      </p>
      <div class="mt-8">
        <slot />
      </div>
    </div>
  </div>
</section>
