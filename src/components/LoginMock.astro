---
import type { ImageMetadata } from 'astro';
import { Eye, EyeOff } from '@lucide/astro';
import { Image } from 'astro:assets';
import BrandIcon from './ui/BrandIcon.astro';
import Logo from './ui/Logo.astro';
import { PENDENTE, site } from '../config/site';

interface Props {
  boasVindas: string;
  destaque: string;
  titulo: string;
  subtitulo: string;
  campoUsuario: { rotulo: string; tipo: 'email' | 'text'; autocomplete: string };
  imagem: ImageMetadata;
}

const { boasVindas, destaque, titulo, subtitulo, campoUsuario, imagem } = Astro.props;

const sociais = [
  { nome: 'facebook', rotulo: 'Facebook', href: site.sociais.facebook },
  { nome: 'instagram', rotulo: 'Instagram', href: site.sociais.instagram },
  { nome: 'x', rotulo: 'X (Twitter)', href: site.sociais.x },
  { nome: 'youtube', rotulo: 'YouTube', href: site.sociais.youtube },
] as const;
---

<section class="grid bg-white lg:min-h-[52rem] lg:grid-cols-[1.39fr_1fr]">
  <div class="relative isolate flex min-h-72 items-center justify-center overflow-hidden bg-noite px-6 py-12 text-center text-white">
    <Image
      src={imagem}
      alt=""
      widths={[768, 1280, imagem.width]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="eager"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-noite/40" aria-hidden="true"></div>
    <div>
      <p class="text-xl md:text-2xl">{boasVindas}</p>
      <p class="text-3xl font-bold md:text-4xl xl:text-[2.6rem]">{destaque}</p>
      <ul class="mt-4 flex justify-center gap-4">
        {
          sociais.map((s) => (
            <li>
              <a href={s.href} data-pendente aria-label={s.rotulo} class="block p-2 hover:text-laranja-300">
                <BrandIcon nome={s.nome} class="size-6" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="flex items-center justify-center px-6 py-14">
    <div class="w-full max-w-md">
      <Logo variante="roxo" class="h-14 w-auto xl:h-16" />
      <h1 class="mt-8 text-3xl font-bold text-roxo xl:text-4xl">{titulo}</h1>
      <p class="mt-1 text-lg text-roxo xl:text-xl">{subtitulo}</p>

      <!-- TODO: rotas de autenticação pendentes; o envio é apenas simulado. -->
      <form class="mt-8 flex flex-col gap-3" data-login novalidate>
        <div class="rounded-lg border border-roxo px-3 pt-1.5 pb-1 focus-within:ring-2 focus-within:ring-roxo/30">
          <label for="login-usuario" class="block text-xs text-roxo">{campoUsuario.rotulo}</label>
          <input
            id="login-usuario"
            name="usuario"
            type={campoUsuario.tipo}
            autocomplete={campoUsuario.autocomplete}
            required
            class="w-full bg-transparent pb-1 text-roxo-logo outline-none"
          />
        </div>
        <div class="flex items-center rounded-lg border border-roxo px-3 pt-1.5 pb-1 focus-within:ring-2 focus-within:ring-roxo/30">
          <div class="flex-1">
            <label for="login-senha" class="block text-xs text-roxo">Senha</label>
            <input
              id="login-senha"
              name="senha"
              type="password"
              autocomplete="current-password"
              required
              class="w-full bg-transparent pb-1 text-roxo-logo outline-none"
            />
          </div>
          <button
            type="button"
            class="p-1 text-roxo/60 hover:text-roxo"
            aria-label="Mostrar senha"
            aria-pressed="false"
            data-alternar-senha
          >
            <EyeOff class="size-6" aria-hidden="true" data-icone-oculta />
            <Eye class="hidden size-6" aria-hidden="true" data-icone-visivel />
          </button>
        </div>
        <button type="submit" class="bg-gradiente-laranja mt-1 h-13 rounded-lg text-lg font-bold text-white hover:brightness-110">
          Entrar
        </button>
        <p class="min-h-6 text-center text-sm text-roxo" role="status" data-login-status></p>
        <a href={PENDENTE} data-pendente class="mx-auto border-b border-roxo text-sm text-roxo hover:text-laranja-500">
          Esqueceu sua senha?
        </a>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-login]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-login-status]');
    const senha = form.querySelector<HTMLInputElement>('#login-senha');
    const alternar = form.querySelector<HTMLButtonElement>('[data-alternar-senha]');

    alternar?.addEventListener('click', () => {
      if (!senha) return;
      const visivel = senha.type === 'text';
      senha.type = visivel ? 'password' : 'text';
      alternar.setAttribute('aria-pressed', String(!visivel));
      alternar.setAttribute('aria-label', visivel ? 'Mostrar senha' : 'Ocultar senha');
      alternar.querySelector('[data-icone-oculta]')?.classList.toggle('hidden', !visivel);
      alternar.querySelector('[data-icone-visivel]')?.classList.toggle('hidden', visivel);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const invalido = [...form.querySelectorAll<HTMLInputElement>('input')].find((i) => !i.checkValidity());
      if (invalido) {
        if (status) status.textContent = 'Preencha os campos corretamente.';
        invalido.focus();
        return;
      }
      // Login simulado até a integração com as rotas reais.
      if (status) status.textContent = 'Ambiente de demonstração: o acesso será integrado em breve.';
    });
  });
</script>
