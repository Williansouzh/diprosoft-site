---
import { Image } from 'astro:assets';
import Carrossel from '../ui/Carrossel.astro';
import imagem from '../../assets/img/case-placeholder.jpg';
import { PENDENTE } from '../../config/site';

// Cases provisórios: o design repete o mesmo card com texto lorem ipsum.
const cases = Array.from({ length: 4 }, (_, i) => ({
  id: i + 1,
  titulo: 'Lorem ipsum dolor sit amet, consectetuer adipiscing elit',
  texto: 'O dashboard gerencial de que você precisa para tomar decisões rápidas e aumentar seus resultados.',
  href: PENDENTE,
}));
---

<section id="cases" class="bg-cinza-100 py-16 xl:py-20">
  <div class="container-site">
    <h2 class="text-center text-4xl font-black text-roxo uppercase xl:text-[3.5rem]">Cases</h2>
    <p class="mt-2 text-center text-lg text-roxo xl:text-2xl">Resultados reais que comprovam nossa expertise</p>

    <div class="mt-10 xl:mt-14">
      <Carrossel rotulo="Cases de clientes">
        {
          cases.map((c) => (
            <li class="w-[85%] shrink-0 snap-start sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-4.5rem)/4)] xl:w-[calc((100%-4.5rem)/4)]">
              <article class="relative flex h-full flex-col rounded-xl border border-roxo bg-cinza-100 p-4 xl:p-5">
                <Image
                  src={imagem}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 25vw, 85vw"
                  class="aspect-[360/173] w-full rounded-lg object-cover"
                />
                <h3 class="mt-4 text-xl leading-tight font-bold text-roxo xl:text-[1.6rem]">{c.titulo}</h3>
                <p class="mt-3 flex-1 text-sm text-roxo">{c.texto}</p>
                <a
                  href={c.href}
                  data-pendente
                  class="bg-gradiente-laranja mt-4 inline-flex w-36 items-center justify-center rounded py-1.5 text-sm font-bold text-white hover:brightness-110"
                >
                  Abrir
                  <span class="sr-only">case {c.id}</span>
                </a>
              </article>
            </li>
          ))
        }
      </Carrossel>
    </div>
  </div>
</section>
